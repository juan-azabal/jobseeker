GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SESSION_SECRET=your_random_secret_key
BASE_URL=http://localhost:8000
DB_PATH=data/jobseeker.db
JOBAGENT_DIR=agent

# CV Generation
CV_LLM_PROVIDER=anthropic          # anthropic | openai
CV_LLM_MODEL=                      # optional override (defaults: claude-sonnet-4-5-20250514 / gpt-4o)
ANTHROPIC_API_KEY=your_anthropic_api_key
CV_REFERENCES_DIR=                 # optional override, defaults to api/cv/references/

# Agent (scraping/scoring engine)
OPENAI_API_KEY=your_openai_api_key
GMAIL_ADDRESS=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTIFY_EMAIL=yourname@gmail.com
RESEND_API_KEY=your_resend_api_key

# Admin system
ADMIN_EMAILS=yourname@gmail.com    # comma-separated; users with these emails get is_admin=1 on login

# GitHub Actions pipeline trigger (admin page + onboarding)
GH_ACTIONS_TOKEN=ghp_xxxxxxxxxxxx  # PAT with contents:write + actions:write scopes
GH_REPO=owner/repo                 # e.g. juan-azabal/jobseeker
GH_REF=main                        # branch to dispatch workflow on
