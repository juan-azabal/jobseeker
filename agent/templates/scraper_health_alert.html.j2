<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Scraper Health Alert</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 14px; color: #1a1a1a; margin: 0; padding: 24px; background: #f5f5f5; }
    .card { background: #fff; border-radius: 8px; padding: 24px; max-width: 640px; margin: 0 auto; border: 1px solid #e0e0e0; }
    h2 { margin: 0 0 4px; font-size: 18px; }
    .meta { color: #666; font-size: 12px; margin-bottom: 20px; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; font-size: 11px; text-transform: uppercase; color: #888; border-bottom: 1px solid #e0e0e0; padding: 6px 8px; }
    td { padding: 8px; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
    .ok     { color: #16a34a; font-weight: bold; }
    .warning  { color: #d97706; font-weight: bold; }
    .critical { color: #dc2626; font-weight: bold; }
    .reasons { font-size: 12px; color: #555; margin: 0; padding: 0; list-style: none; }
    .reasons li { margin-top: 2px; }
  </style>
</head>
<body>
<div class="card">
  <h2>⚠ Scraper Health Alert</h2>
  <p class="meta">
    {{ data.timestamp }} &nbsp;·&nbsp;
    {{ data.n_critical }} critical &nbsp;·&nbsp;
    {{ data.n_warning }} warning &nbsp;·&nbsp;
    {{ data.n_ok }} ok
  </p>

  <table>
    <thead>
      <tr>
        <th>Source</th>
        <th>Verdict</th>
        <th>Jobs</th>
        <th>Diagnostics</th>
      </tr>
    </thead>
    <tbody>
      {% for src in data.sources %}
      <tr>
        <td><strong>{{ src.source }}</strong></td>
        <td><span class="{{ src.verdict }}">{{ src.verdict.upper() }}</span></td>
        <td>{{ src.job_count }}</td>
        <td>
          {% if src.reasons %}
          <ul class="reasons">
            {% for r in src.reasons %}<li>{{ r }}</li>{% endfor %}
          </ul>
          {% else %}
          —
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</body>
</html>
